<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
<%- include('./partials/navbar') %>

<% for(entry of myEntries){ %>

<h1><%=entry.title%></h1>
<p><%=entry.entryBody%></p>
<p><%=entry.owner%></p>
<% if(user && entry.owner.equals(user._id)){ %>

<form action="/my-entries/<%= entry._id %>?_method=DELETE" method="POST">
    <button>Delete</button>
</form>
<br>
<a href="/entries/<%= entry._id %>/edit">
    <button>Edit</button>
</a>

<% }%>
<% }%>

</body>
</html>